rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function userDoc(userId) {
      return firestore.get(/databases/(default)/documents/users/$(userId));
    }

    function isActiveUser(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && userDoc(userId).data.get('status', 'active') != 'blocked';
    }

    function uploadTicket(userId, ticketId) {
      return firestore.get(/databases/(default)/documents/users/$(userId)/uploadTickets/$(ticketId));
    }

    function ticketWriteOk(userId) {
      let ticketId = request.resource.metadata.uploadTicket;
      let ticket = uploadTicket(userId, ticketId);
      return ticketId != null
        && ticket.data != null
        && ticket.data.used == false
        && request.time < ticket.data.expiresAt
        && request.resource.size <= ticket.data.maxBytes
        && request.resource.contentType.matches(ticket.data.contentTypePattern)
        && (request.resource.name == ticket.data.storagePath
            || ('companionPath' in ticket.data
                && request.resource.name == ticket.data.companionPath
                && request.resource.size <= ticket.data.companionMaxBytes));
    }

    function ownerTicketWrite(userId) {
      return isActiveUser(userId) && ticketWriteOk(userId);
    }

    // Bar 4 Bar First Drops — private masters. Playback streams through /api/drops/audio.
    match /drops/{userId}/{allPaths=**} {
      allow read: if false;
      allow write: if ownerTicketWrite(userId);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Wall / comment voice notes — public playback, owner write.
    match /voice/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if ownerTicketWrite(userId);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Wall / comment photos — public playback, owner write.
    match /wall/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if ownerTicketWrite(userId);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Studio sheet takes — private to the artist.
    match /sheet-takes/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if ownerTicketWrite(userId);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
