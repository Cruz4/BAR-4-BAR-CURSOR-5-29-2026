
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      let masterEmail = 'plotformaiplan@gmail.com';
      let isMaster = request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == masterEmail;
      let hasProfile = request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
      let hasRole = hasProfile
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
      let masterByProfile = hasProfile
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('email', '').lower() == masterEmail;
      return isMaster || hasRole || masterByProfile;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isOwnerOrAdmin(userId) {
      return isOwner(userId) || isAdmin();
    }

    function isPaidPro(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.get('subscriptionStatus', 'none') == 'active';
    }

    // Public social writing requires the author's Artist Home to be live.
    // The summary is server-owned, so a modified client cannot fake this flag.
    function hasLiveArtistHome(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && exists(/databases/$(database)/documents/users/$(userId)/gamification/summary)
        && get(/databases/$(database)/documents/users/$(userId)/gamification/summary).data.get('publicProfile', false) == true
        && get(/databases/$(database)/documents/users/$(userId)/gamification/summary).data.get('profileSlug', '') is string
        && get(/databases/$(database)/documents/users/$(userId)/gamification/summary).data.get('profileSlug', '').size() > 0;
    }

    function isCollabSheetMember(collabId) {
      let sheet = get(/databases/$(database)/documents/collabSheets/$(collabId)).data;
      return request.auth != null
        && request.auth.uid in sheet.memberIds
        && sheet.get('revoked', {}).get(request.auth.uid, false) != true;
    }

    // Server-owned counters (Admin SDK). Clients may keep an existing value or omit it.
    function lockedServerNumber(key) {
      return !(key in request.resource.data)
        || (!(key in resource.data) && request.resource.data[key] == 0)
        || (key in resource.data && request.resource.data[key] == resource.data[key]);
    }

    function validVoiceNote(data) {
      return data is map
        && data.keys().hasAll(['url', 'storagePath', 'contentType', 'durationSec', 'byteSize'])
        && data.keys().hasOnly(['url', 'storagePath', 'contentType', 'durationSec', 'byteSize', 'transcript'])
        && data.url is string
        && data.url.size() > 8
        && data.url.size() <= 2000
        && data.storagePath is string
        && data.storagePath.size() > 0
        && data.storagePath.size() <= 400
        && data.storagePath.matches('voice/' + request.auth.uid + '/.*')
        && data.contentType is string
        && data.contentType.size() > 0
        && data.contentType.size() <= 80
        && data.contentType.matches('audio/.*')
        && data.durationSec is number
        && data.durationSec > 0
        && data.durationSec <= 90
        && data.byteSize is number
        && data.byteSize > 0
        && data.byteSize <= 5242880
        && (!('transcript' in data)
          || (data.transcript is string && data.transcript.size() <= 4000));
    }

    function validWallImagePath(path) {
      return path is string
        && path.size() > 0
        && path.size() <= 400
        && path.matches('wall/' + request.auth.uid + '/.*');
    }

    function validWallClip(data) {
      return data is map
        && data.keys().hasAll(['url', 'storagePath', 'contentType', 'durationSec', 'byteSize'])
        && data.keys().hasOnly(['url', 'storagePath', 'contentType', 'durationSec', 'byteSize'])
        && data.url is string
        && data.url.size() > 8
        && data.url.size() <= 2000
        && validWallImagePath(data.storagePath)
        && data.contentType is string
        && data.contentType.size() > 0
        && data.contentType.size() <= 80
        && data.contentType.matches('video/.*')
        && data.durationSec is number
        && data.durationSec > 0
        && data.durationSec <= 45
        && data.byteSize is number
        && data.byteSize > 0
        && data.byteSize <= 20971520;
    }

    function validReverbWallClip(data) {
      return data is map
        && data.keys().hasAll(['url', 'storagePath', 'contentType', 'durationSec', 'byteSize'])
        && data.keys().hasOnly(['url', 'storagePath', 'contentType', 'durationSec', 'byteSize'])
        && data.url is string
        && data.url.size() > 8
        && data.url.size() <= 2000
        && data.storagePath is string
        && data.storagePath.size() > 0
        && data.storagePath.size() <= 400
        && data.contentType is string
        && data.contentType.size() > 0
        && data.contentType.size() <= 80
        && data.contentType.matches('video/.*')
        && data.durationSec is number
        && data.durationSec > 0
        && data.durationSec <= 45
        && data.byteSize is number
        && data.byteSize > 0;
    }

    function validReverbVoiceNote(data) {
      return data is map
        && data.keys().hasAll(['url', 'storagePath', 'contentType', 'durationSec', 'byteSize'])
        && data.keys().hasOnly(['url', 'storagePath', 'contentType', 'durationSec', 'byteSize', 'transcript'])
        && data.url is string
        && data.url.size() > 8
        && data.url.size() <= 2000
        && data.storagePath is string
        && data.storagePath.size() > 0
        && data.storagePath.size() <= 400
        && data.contentType is string
        && data.contentType.size() > 0
        && data.contentType.size() <= 80
        && data.durationSec is number
        && data.durationSec > 0
        && data.byteSize is number
        && data.byteSize > 0
        && (!('transcript' in data)
          || (data.transcript is string && data.transcript.size() <= 4000));
    }

    function validPollOption(option, expectedId) {
      return option is map
        && option.keys().hasAll(['id', 'label'])
        && option.keys().hasOnly(['id', 'label'])
        && option.id == expectedId
        && option.label is string
        && option.label.size() > 0
        && option.label.size() <= 120;
    }

    function validPostPoll(data) {
      return data is map
        && data.keys().hasAll(['options', 'resultsVisibility'])
        && data.keys().hasOnly(['options', 'resultsVisibility'])
        && data.options is list
        && data.options.size() >= 2
        && data.options.size() <= 6
        && (data.resultsVisibility == 'after_vote' || data.resultsVisibility == 'always')
        && validPollOption(data.options[0], 'option_1')
        && validPollOption(data.options[1], 'option_2')
        && (data.options.size() < 3 || validPollOption(data.options[2], 'option_3'))
        && (data.options.size() < 4 || validPollOption(data.options[3], 'option_4'))
        && (data.options.size() < 5 || validPollOption(data.options[4], 'option_5'))
        && (data.options.size() < 6 || validPollOption(data.options[5], 'option_6'));
    }

    function validQuotePressFaders(faders) {
      return faders is map
        && faders.keys().hasAll(['heat', 'grain', 'pace', 'ink'])
        && faders.keys().hasOnly(['heat', 'grain', 'pace', 'ink'])
        && faders.heat is int && faders.heat >= 0 && faders.heat <= 100
        && faders.grain is int && faders.grain >= 0 && faders.grain <= 100
        && faders.pace is int && faders.pace >= 0 && faders.pace <= 100
        && faders.ink is int && faders.ink >= 0 && faders.ink <= 100;
    }

    function validQuotePress(data) {
      return data is map
        && data.keys().hasAll(['faders'])
        && data.keys().hasOnly(['faders'])
        && validQuotePressFaders(data.faders);
    }

    // Client bootstrap only — privileged billing/admin fields must stay at safe defaults
    function isSafeUserBootstrap() {
      let data = request.resource.data;
      let roleOk = !('role' in data) || data.role == 'artist';
      let subOk = !('subscriptionStatus' in data) || data.subscriptionStatus == 'none';
      let tierOk = !('subscriptionTier' in data) || data.subscriptionTier == 'none';
      let statusOk = !('status' in data) || data.status == 'active';
      let connectOk = !('stripeConnectAccountId' in data);
      return roleOk && subOk && tierOk && statusOk && connectOk;
    }

    // Public DNA Drop shares
    match /shares/{shareId} {
      allow read: if true;
      allow create: if request.auth != null
        && (!request.resource.data.keys().hasAny(['houseRelease'])
          || request.resource.data.houseRelease == false)
        && (!request.resource.data.keys().hasAny(['houseLibraryNotice'])
          || request.resource.data.houseLibraryNotice == false)
        && !request.resource.data.keys().hasAny(['houseLibraryNoticeAt']);
      allow update: if request.auth != null
        && request.auth.uid == resource.data.ownerId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['houseRelease', 'houseLibraryNotice', 'houseLibraryNoticeAt']);
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;

      match /loves/{likerId} {
        allow read: if true;
        allow create, delete: if request.auth != null && request.auth.uid == likerId;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && hasLiveArtistHome(request.auth.uid)
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500
          && (!('parentCommentId' in request.resource.data)
            || (request.resource.data.parentCommentId is string
              && request.resource.data.parentCommentId.size() <= 80))
          && (!('imageUrl' in request.resource.data)
            || (request.resource.data.imageUrl is string
              && request.resource.data.imageUrl.size() <= 2000))
          && (!('imageStoragePath' in request.resource.data)
            || validWallImagePath(request.resource.data.imageStoragePath))
          && (!('video' in request.resource.data)
            || validWallClip(request.resource.data.video))
          && (
            request.resource.data.text.size() > 0
            || ('imageUrl' in request.resource.data && request.resource.data.imageUrl.size() > 0)
            || ('video' in request.resource.data && validWallClip(request.resource.data.video))
          );
        allow delete: if request.auth != null
          && (resource.data.authorId == request.auth.uid
            || get(/databases/$(database)/documents/shares/$(shareId)).data.ownerId == request.auth.uid
            || isAdmin());

        match /likes/{likerId} {
          allow read: if true;
          allow create, delete: if request.auth != null && request.auth.uid == likerId;
        }
      }

      match /spinTicks/{tickId} {
        allow read, write: if false;
      }

      // Qualified playback evidence is accepted and aggregated by server APIs only.
      match /listenTicks/{tickId} {
        allow read, write: if false;
      }
    }

    // Open LOCK — public read; mutations via Admin SDK APIs only
    match /locks/{lockId} {
      allow read: if true;
      allow write: if false;

      match /echoes/{echoId} {
        allow read: if true;
        allow write: if false;
        match /likes/{userId} {
          allow read: if true;
          allow write: if false;
        }
      }
      match /watchers/{userId} {
        allow read: if isOwnerOrAdmin(userId);
        allow write: if false;
      }
      match /clearOffers/{userId} {
        allow read: if isOwnerOrAdmin(userId);
        allow write: if false;
      }
    }

    match /referrals/{referralId} {
      allow read, write: if false;
    }

    // One-time signup entitlements keyed by hashed email — Admin SDK only
    match /identityRegistry/{docId} {
      allow read, write: if false;
    }

    // User profile — owner can update except privileged billing fields
    match /users/{userId} {
      allow read: if isOwnerOrAdmin(userId);
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isSafeUserBootstrap();
      allow update: if isAdmin()
        || (isOwner(userId)
          && !('status' in resource.data)
          && request.resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'displayName', 'email', 'photoURL', 'lastLogin',
            'trialStartedAt', 'signupAttribution', 'createdAt'
          ]))
        || (isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'subscriptionStatus', 'subscriptionTier', 'status',
            'subscriptionId', 'stripeCustomerId', 'referredBy', 'referralCode', 'referralCount',
            'stripeConnectAccountId', 'stripeConnectCountry', 'stripeConnectDetailsSubmitted',
            'stripeConnectTransfersActive', 'stripeConnectPayoutsEnabled',
            'returningIdentity', 'proFeaturePreviewExpiresAt', 'pendingWelcomeInk', 'welcomeInkReconciled',
            'freeAlbumId', 'freeEditableTrackIds', 'freeEditableSelectionAt'
          ]));
      allow delete: if isOwner(userId) || isAdmin();

      // Ink balance — server (Admin SDK) only
      match /usage/balance {
        allow read: if isOwnerOrAdmin(userId);
        allow write: if false;
      }

      match /usage/{docId} {
        allow read: if isOwnerOrAdmin(userId);
        allow write: if false;
      }

      match /usageLogs/{logId} {
        allow read: if isOwnerOrAdmin(userId);
        allow write: if false;
      }

      match /albums/{albumId} {
        allow read: if isOwnerOrAdmin(userId);
        allow create: if isAdmin()
          || (isOwner(userId)
            && (isPaidPro(userId)
              || albumId == 'unassigned'
              || get(/databases/$(database)/documents/users/$(userId)).data.get('freeAlbumId', '') == albumId));
        allow update, delete: if isOwnerOrAdmin(userId);

        match /tracks/{trackId} {
          allow read: if isOwnerOrAdmin(userId);
          allow create: if isAdmin()
            || (isOwner(userId)
              && (isPaidPro(userId)
                || trackId in get(/databases/$(database)/documents/users/$(userId)).data.get('freeEditableTrackIds', [])));
          allow update, delete: if isOwnerOrAdmin(userId);
        }
      }

      match /styleProfile/{docId} {
        allow read, write: if isOwnerOrAdmin(userId);
      }

      match /analytics/{docId} {
        allow read: if isOwnerOrAdmin(userId);
        allow write: if false;
      }

      // Artist Intelligence CRM overlays — Admin SDK / intelligence API only
      match /supportCrm/{peerId} {
        allow read: if isOwnerOrAdmin(userId);
        allow write: if false;
      }

      match /gamification/{docId} {
        allow read: if isOwnerOrAdmin(userId);
        allow write: if false;
      }

      // Server-owned AI session accounting; never trust client chunk counters.
      match /aiSessions/{docId} {
        allow read, write: if false;
      }

      // Server-owned signed-in device registry; clients use the authenticated session API.
      match /authSessions/{sessionId} {
        allow read, write: if false;
      }

      // Global session revocation cutoff used by the server session heartbeat.
      match /security/{docId} {
        allow read, write: if false;
      }

      // Upload tickets + daily quotas — Admin SDK / ticket API only
      match /uploadTickets/{ticketId} {
        allow read, write: if false;
      }

      match /uploadQuota/{docId} {
        allow read, write: if false;
      }

      // Social blocks — only the blocker can read/write their own list
      match /blocks/{blockedUid} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.auth.uid != blockedUid
          && request.resource.data.blockedUserId == blockedUid
          && request.resource.data.blockedUserId is string
          && request.resource.data.createdAt is string;
        allow delete: if isOwner(userId);
      }

      // Reverb pointers — which original posts this artist has Reverbed
      match /reverbs/{originalPostId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.wallPostId is string
          && request.resource.data.wallPostId.size() <= 80
          && request.resource.data.createdAt is string;
        allow delete: if isOwner(userId);
      }

      // Personal imprint collection — server writes via Admin SDK
      match /imprintCollection/{postId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Activity inbox — Admin SDK writes events; owner reads / marks read / manages prefs+push
      match /activity/{eventId} {
        allow read: if isOwner(userId);
        allow create, delete: if false;
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
      }

      match /activityMeta/{docId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && (docId == 'prefs' || docId == 'push' || docId == 'craft');
        allow delete: if isOwner(userId) && (docId == 'prefs' || docId == 'push' || docId == 'craft');
      }

      match /doorPresence/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /doorKnockLive/{knockId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /doorKnocks/{knockId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /doorKnockQuota/{dayKey} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /doorKnockInbox/{dayKey} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Contact requests — Admin SDK writes; artist + requester can read status.
      match /contactRequests/{requesterId} {
        allow read: if request.auth != null
          && (isOwner(userId) || request.auth.uid == requesterId);
        allow write: if false;
      }

      // First Drops library — Admin SDK writes; owner reads
      match /dropLibrary/{shareId} {
        allow read: if isOwnerOrAdmin(userId);
        allow write: if false;
      }

      // Artist First Drop sales ledger — Admin SDK writes; owner reads
      match /dropEarnings/{saleId} {
        allow read: if isOwnerOrAdmin(userId);
        allow write: if false;
      }

      match /dropPayouts/{docId} {
        allow read: if isOwnerOrAdmin(userId);
        allow write: if false;
      }

      // Private creator listening/supporter analytics. Served through owner-authenticated APIs.
      match /dropInsights/{docId} {
        allow read, write: if false;
      }
      match /dropInsightDays/{docId} {
        allow read, write: if false;
      }
      match /dropAudience/{docId} {
        allow read, write: if false;
      }
      match /dropPurchaseTicks/{docId} {
        allow read, write: if false;
      }

      // One-way Follow + Inner Circle graph. Mutations and counts are server-validated.
      match /following/{targetUserId} {
        allow read, write: if false;
      }
      match /followers/{followerUserId} {
        allow read, write: if false;
      }
      match /organicRelationshipTicks/{tickId} {
        allow read, write: if false;
      }

      // The Deck crates (playlists of unlocked drops)
      match /dropCrates/{crateId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 48
          && request.resource.data.shareIds is list
          && request.resource.data.shareIds.size() <= 80
          && request.resource.data.createdAt is string
          && request.resource.data.updatedAt is string;
        allow update: if isOwner(userId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 48
          && request.resource.data.shareIds is list
          && request.resource.data.shareIds.size() <= 80;
        allow delete: if isOwner(userId);
      }
    }

    match /publicProfiles/{slug} {
      allow read: if true;
      allow write: if false;

      // Compact feed avatar (custom photo or collage cover) — separate from the
      // main doc so Artist Home banners don't blow the 1MB limit.
      match /assets/{assetId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Artist Home wall/feed posts — public read, owner writes
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && hasLiveArtistHome(request.auth.uid)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000
        && (!('embedUrl' in request.resource.data)
          || (request.resource.data.embedUrl is string
            && request.resource.data.embedUrl.size() <= 500))
        && (!('imageUrl' in request.resource.data)
          || (request.resource.data.imageUrl is string
            && request.resource.data.imageUrl.size() <= 900000))
        && (!('imageStoragePath' in request.resource.data)
          || validWallImagePath(request.resource.data.imageStoragePath))
        && (!('video' in request.resource.data)
          || validWallClip(request.resource.data.video))
        && (!('reverbVideo' in request.resource.data)
          || validReverbWallClip(request.resource.data.reverbVideo))
        && (!('isReverb' in request.resource.data)
          || request.resource.data.isReverb == true)
        && (!('reverbPostId' in request.resource.data)
          || (request.resource.data.reverbPostId is string
            && request.resource.data.reverbPostId.size() <= 80))
        && (!('reverbOwnerId' in request.resource.data)
          || (request.resource.data.reverbOwnerId is string
            && request.resource.data.reverbOwnerId.size() <= 128))
        && (!('reverbOwnerName' in request.resource.data)
          || (request.resource.data.reverbOwnerName is string
            && request.resource.data.reverbOwnerName.size() <= 120))
        && (!('reverbOwnerSlug' in request.resource.data)
          || (request.resource.data.reverbOwnerSlug is string
            && request.resource.data.reverbOwnerSlug.size() <= 80))
        && (!('reverbText' in request.resource.data)
          || (request.resource.data.reverbText is string
            && request.resource.data.reverbText.size() <= 1000))
        && (!('reverbEmbedUrl' in request.resource.data)
          || (request.resource.data.reverbEmbedUrl is string
            && request.resource.data.reverbEmbedUrl.size() <= 500))
        && (!('reverbImageUrl' in request.resource.data)
          || (request.resource.data.reverbImageUrl is string
            && request.resource.data.reverbImageUrl.size() <= 900000))
        && (!('voice' in request.resource.data)
          || validVoiceNote(request.resource.data.voice))
        && (!('reverbVoice' in request.resource.data)
          || validReverbVoiceNote(request.resource.data.reverbVoice))
        && (!('lyricClip' in request.resource.data)
          || request.resource.data.lyricClip is map)
        && (!('reverbLyricClip' in request.resource.data)
          || request.resource.data.reverbLyricClip is map)
        && (!('poll' in request.resource.data)
          || (validPostPoll(request.resource.data.poll)
            && request.resource.data.text.size() > 0))
        && (!('reverbPoll' in request.resource.data)
          || validPostPoll(request.resource.data.reverbPoll))
        && (
          request.resource.data.text.size() > 0
          || ('embedUrl' in request.resource.data && request.resource.data.embedUrl.size() > 0)
          || ('imageUrl' in request.resource.data && request.resource.data.imageUrl.size() > 0)
          || ('video' in request.resource.data && validWallClip(request.resource.data.video))
          || ('voice' in request.resource.data && validVoiceNote(request.resource.data.voice))
          || ('lyricClip' in request.resource.data && request.resource.data.lyricClip is map)
          || (request.resource.data.isReverb == true
            && 'reverbPostId' in request.resource.data
            && request.resource.data.reverbPostId.size() > 0)
        );
      allow update: if request.auth != null
        && hasLiveArtistHome(request.auth.uid)
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['poll', 'reverbPoll'])
        && lockedServerNumber('viewCount')
        && lockedServerNumber('imprintSaveCount');
      allow delete: if request.auth != null
        && (resource.data.ownerId == request.auth.uid || isAdmin());

      match /likes/{likerId} {
        allow read: if true;
        allow create, delete: if request.auth != null && request.auth.uid == likerId;
      }

      match /reverbs/{reverberId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.auth.uid == reverberId
          && request.resource.data.wallPostId is string
          && request.resource.data.wallPostId.size() > 0
          && request.resource.data.createdAt is string;
        allow delete: if request.auth != null && request.auth.uid == reverberId;
      }

      match /imprintSaves/{saverId} {
        allow read: if true;
        allow write: if false;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && hasLiveArtistHome(request.auth.uid)
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500
          && (!('parentCommentId' in request.resource.data)
            || (request.resource.data.parentCommentId is string
              && request.resource.data.parentCommentId.size() <= 80))
          && (!('voice' in request.resource.data)
            || validVoiceNote(request.resource.data.voice))
          && (!('imageUrl' in request.resource.data)
            || (request.resource.data.imageUrl is string
              && request.resource.data.imageUrl.size() <= 2000))
          && (!('imageStoragePath' in request.resource.data)
            || validWallImagePath(request.resource.data.imageStoragePath))
          && (!('video' in request.resource.data)
            || validWallClip(request.resource.data.video))
          && (!('poll' in request.resource.data)
            || (validPostPoll(request.resource.data.poll)
              && request.resource.data.text.size() > 0))
          && (!('quotePress' in request.resource.data)
            || (validQuotePress(request.resource.data.quotePress)
              && request.resource.data.text.size() > 0))
          && (
            request.resource.data.text.size() > 0
            || ('voice' in request.resource.data && validVoiceNote(request.resource.data.voice))
            || ('imageUrl' in request.resource.data && request.resource.data.imageUrl.size() > 0)
            || ('video' in request.resource.data && validWallClip(request.resource.data.video))
          );
        allow delete: if request.auth != null
          && (resource.data.authorId == request.auth.uid
            || get(/databases/$(database)/documents/posts/$(postId)).data.ownerId == request.auth.uid
            || isAdmin());

        match /likes/{likerId} {
          allow read: if true;
          allow create, delete: if request.auth != null && request.auth.uid == likerId;
        }

        match /pollVotes/{voterId} {
          allow read, write: if false;
        }

        match /pollPrivate/{documentId} {
          allow read, write: if false;
        }
      }

      // Votes and aggregate results are Admin SDK-only. Public post reads must
      // never reveal a person's choice or early results.
      match /pollVotes/{voterId} {
        allow read, write: if false;
      }

      match /pollPrivate/{documentId} {
        allow read, write: if false;
      }

      match /viewTicks/{tickId} {
        allow read, write: if false;
      }
    }

    // Friend graph — accepted friendships are public (friends list on profile),
    // pending requests visible only to the two participants.
    // Split get/list so list queries with array-contains + status filters are provable.
    match /friendships/{pairId} {
      // Missing docs must be readable so clients can probe "are we friends?" /
      // send a request without a false permissions error.
      allow get: if !exists(/databases/$(database)/documents/friendships/$(pairId))
        || resource.data.status == 'accepted'
        || (request.auth != null && request.auth.uid in resource.data.uids);
      allow list: if resource.data.status == 'accepted'
        || (request.auth != null && request.auth.uid in resource.data.uids);
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['uids', 'requestedBy', 'status', 'profiles', 'createdAt'])
        && request.resource.data.uids is list
        && request.resource.data.uids.size() == 2
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.uids[0] != request.resource.data.uids[1]
        && request.resource.data.status == 'pending';
      allow update: if request.auth != null
        && request.auth.uid in resource.data.uids
        && request.auth.uid != resource.data.requestedBy
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']);
      allow delete: if request.auth != null
        && (request.auth.uid in resource.data.uids || isAdmin());
    }

    // After unfriending Neo (or Neo unfriending you), block founder-welcome from
    // recreating the accepted edge on the next usage-init.
    match /founderFriendDismissals/{pairId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.uids;
      allow create: if request.auth != null
        && request.resource.data.uids is list
        && request.resource.data.uids.size() == 2
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.dismissedBy == request.auth.uid
        && request.resource.data.dismissedAt is string;
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.uids;
      allow update: if false;
    }

    // Profile guestbook — one line per visitor (doc id == author uid);
    // profile owner can moderate (delete)
    match /guestbooks/{ownerUid}/entries/{authorUid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && hasLiveArtistHome(request.auth.uid)
        && request.auth.uid == authorUid
        && request.auth.uid != ownerUid
        && request.resource.data.authorId == authorUid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 240;
      allow delete: if request.auth != null
        && (request.auth.uid == authorUid || request.auth.uid == ownerUid || isAdmin());
    }

    // The Board — one reply per visitor per pin (doc id == author uid)
    match /boardReplies/{ownerUid}/pins/{pinId}/entries/{authorUid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && hasLiveArtistHome(request.auth.uid)
        && request.auth.uid == authorUid
        && request.auth.uid != ownerUid
        && request.resource.data.authorId == authorUid
        && request.resource.data.pinId == pinId
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 160;
      allow delete: if request.auth != null
        && (request.auth.uid == authorUid || request.auth.uid == ownerUid || isAdmin());
    }

    match /leaderboard_weekly/{weekId} {
      allow read: if true;
      allow write: if false;

      match /entries/{entryId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }

    match /tonightsForms/{nightKey} {
      allow read: if true;
      allow write: if false;
    }

    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system/logs/entries/{entryId} {
      allow create: if request.auth != null;
      allow read: if isAdmin()
        || (request.auth != null && resource.data.userId == request.auth.uid);
    }

    match /stripe_webhook_events/{eventId} {
      allow read, write: if false;
    }

    match /stripe_fulfilled_sessions/{sessionId} {
      allow read, write: if false;
    }

    // Shared server-side abuse counters. Admin SDK only.
    match /rate_limits/{bucketId} {
      allow read, write: if false;
    }

    // Daily inputs for the transparent Emerging board. Admin SDK only.
    match /emergingSignals/{day}/{document=**} {
      allow read, write: if false;
    }

    match /analytics_events/{eventId} {
      allow create, update, delete: if false;
      allow read: if isAdmin();
    }

    // AnalyticsEventV2 append-only raw stream — Admin SDK only
    match /analytics_events_v2/{eventId} {
      allow read, write: if false;
    }

    // Collab Sheets — live lyric collaboration. Admin SDK writes sheet body + chat.
    // Clients read the sheet and heartbeat presence only.
    match /collabSheets/{collabId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberIds
        && resource.data.get('revoked', {}).get(request.auth.uid, false) != true;
      allow write: if false;

      match /messages/{msgId} {
        allow read: if isCollabSheetMember(collabId);
        allow write: if false;
      }

      match /presence/{uid} {
        allow read: if isCollabSheetMember(collabId);
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && isCollabSheetMember(collabId)
          && request.resource.data.keys().hasOnly(['viewing', 'at', 'name'])
          && request.resource.data.at is string
          && request.resource.data.viewing is bool
          && (!('name' in request.resource.data)
            || (request.resource.data.name is string && request.resource.data.name.size() <= 80));
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Folds — shared lyric sheets. Members read; Admin SDK writes bars.
    // Presence (viewing / ink moving) is the only client write.
    match /folds/{foldId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberIds;
      allow write: if false;

      match /bars/{barId} {
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/folds/$(foldId))
          && request.auth.uid in get(/databases/$(database)/documents/folds/$(foldId)).data.memberIds;
        allow write: if false;
      }

      match /presence/{uid} {
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/folds/$(foldId))
          && request.auth.uid in get(/databases/$(database)/documents/folds/$(foldId)).data.memberIds;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && exists(/databases/$(database)/documents/folds/$(foldId))
          && request.auth.uid in get(/databases/$(database)/documents/folds/$(foldId)).data.memberIds
          && request.resource.data.keys().hasOnly(['viewing', 'typing', 'at'])
          && request.resource.data.at is string
          && request.resource.data.viewing is bool
          && request.resource.data.typing is bool;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /studioMetrics/{docId} {
      allow read, write: if isAdmin();
    }

    match /studio_admin_alerts/{alertId} {
      allow read, write: if false;
    }

    match /studio_landing_hits/{hitId} {
      allow read, write: if false;
    }

    match /studio_lock_funnel_events/{eventId} {
      allow read, write: if false;
    }

    match /studio_guest_funnel_events/{eventId} {
      allow read, write: if false;
    }

    // Share Studio campaign codes — Admin SDK only (opaque public refs)
    match /shareCampaigns/{code} {
      allow read, write: if false;
    }

    // Release Room V1 — Admin SDK only
    match /releaseRooms/{roomId} {
      allow read, write: if false;
      match /sessions/{userId} {
        allow read, write: if false;
      }
    }
  }
}
