
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      let masterEmail = 'plotformaiplan@gmail.com';
      let isMaster = request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == masterEmail;
      let hasProfile = request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
      let hasRole = hasProfile
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
      let masterByProfile = hasProfile
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('email', '').lower() == masterEmail;
      return isMaster || hasRole || masterByProfile;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isOwnerOrAdmin(userId) {
      return isOwner(userId) || isAdmin();
    }

    // Client bootstrap only — privileged billing/admin fields must stay at safe defaults
    function isSafeUserBootstrap() {
      let data = request.resource.data;
      let roleOk = !('role' in data) || data.role == 'artist';
      let subOk = !('subscriptionStatus' in data) || data.subscriptionStatus == 'none';
      let tierOk = !('subscriptionTier' in data) || data.subscriptionTier == 'none';
      let statusOk = !('status' in data) || data.status == 'active';
      return roleOk && subOk && tierOk && statusOk;
    }

    // Public DNA Drop shares
    match /shares/{shareId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    match /referrals/{referralId} {
      allow read, write: if false;
    }

    // One-time signup entitlements keyed by hashed email — Admin SDK only
    match /identityRegistry/{docId} {
      allow read, write: if false;
    }

    // User profile — owner can update except privileged billing fields
    match /users/{userId} {
      allow read: if isOwnerOrAdmin(userId);
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isSafeUserBootstrap();
      allow update: if isAdmin()
        || (isOwner(userId)
          && !('status' in resource.data)
          && request.resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'displayName', 'email', 'photoURL', 'lastLogin',
            'trialStartedAt', 'signupAttribution', 'createdAt'
          ]))
        || (isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'subscriptionStatus', 'subscriptionTier', 'status',
            'subscriptionId', 'stripeCustomerId', 'referredBy', 'referralCode', 'referralCount',
            'returningIdentity'
          ]));
      allow delete: if isOwner(userId) || isAdmin();

      // Ink balance — server (Admin SDK) only
      match /usage/balance {
        allow read: if isOwnerOrAdmin(userId);
        allow write: if false;
      }

      match /usage/{docId} {
        allow read: if isOwnerOrAdmin(userId);
        allow write: if false;
      }

      match /usageLogs/{logId} {
        allow read: if isOwnerOrAdmin(userId);
        allow write: if false;
      }

      match /albums/{albumId} {
        allow read, write: if isOwnerOrAdmin(userId);

        match /tracks/{trackId} {
          allow read, write: if isOwnerOrAdmin(userId);
        }
      }

      match /styleProfile/{docId} {
        allow read, write: if isOwnerOrAdmin(userId);
      }

      match /analytics/{docId} {
        allow read: if isOwnerOrAdmin(userId);
        allow write: if false;
      }

      match /gamification/{docId} {
        allow read: if isOwnerOrAdmin(userId);
        allow write: if false;
      }
    }

    match /publicProfiles/{slug} {
      allow read: if true;
      allow write: if false;
    }

    match /leaderboard_weekly/{weekId} {
      allow read: if true;
      allow write: if false;

      match /entries/{entryId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }

    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system/logs/entries/{entryId} {
      allow create: if request.auth != null;
      allow read: if isAdmin()
        || (request.auth != null && resource.data.userId == request.auth.uid);
    }

    match /stripe_webhook_events/{eventId} {
      allow read, write: if false;
    }

    match /stripe_fulfilled_sessions/{sessionId} {
      allow read, write: if false;
    }

    match /analytics_events/{eventId} {
      allow create, update, delete: if false;
      allow read: if isAdmin();
    }

    match /studioMetrics/{docId} {
      allow read, write: if isAdmin();
    }

    match /studio_admin_alerts/{alertId} {
      allow read, write: if false;
    }

    match /studio_landing_hits/{hitId} {
      allow read, write: if false;
    }
  }
}
